POSTGRES_USER=soa
POSTGRES_PASSWORD=soa_dev_password
JWT_SECRET=change-this-development-jwt-secret
INTERNAL_API_TOKEN=change-this-internal-token
OTP_PEPPER=change-this-otp-pepper
ACCESS_TOKEN_MINUTES=30
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_DELIVERY_ATTEMPTS=5
ENABLE_FAULT_INJECTION=false

# Email người dùng demo. Đổi thành các địa chỉ thật và không dùng trùng email.
DEMO_EMAIL_1=payer1@example.com
DEMO_EMAIL_2=payer2@example.com
DEMO_EMAIL_3=payer3@example.com

# SMTP thật. Ví dụ Gmail: smtp.gmail.com / 587 / STARTTLS.
# Giữ bí mật SMTP_PASSWORD trong file .env cục bộ, không commit lên GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FROM_EMAIL=your-account@gmail.com

# Chỉ dùng khi chạy kiểm thử E2E bằng hộp thư thật.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-account@gmail.com
IMAP_PASSWORD=your-16-character-app-password
